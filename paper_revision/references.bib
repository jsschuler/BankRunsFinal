  author = {{U.S.\ Securities and Exchange Commission}},
  year = {2023},
  note = {SEC Release No.\ IC-34959 (July 12, 2023); compliance date
          October 2, 2023; eliminated redemption gates and severed the
          link between discretionary liquidity fees and the 30\,\%
          weekly-liquid-assets threshold, replacing it with a mandatory
          liquidity fee for institutional prime and institutional
          tax-exempt funds triggered by daily net redemptions exceeding
          5\,\% of net assets; the adopting release states that even
          though no fund imposed a fee or gate in March 2020, ``the
          possibility of their imposition after crossing the publicly
          disclosed 30\,\% weekly liquid asset threshold appears to
          have contributed to investors' incentives to redeem''}
}

